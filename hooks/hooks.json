{
  "description": "letapis: recall what happened before this session, before acting",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/recall-first.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
